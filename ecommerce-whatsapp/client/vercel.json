{
    "rewrites": [
        {
            "source": "/feed.xml",
            "destination": "/api/feed.xml"
        },
        {
            "source": "/api/facebook/:action",
            "destination": "/api/fb-events?action=:action"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}